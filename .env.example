# Copy this file to .env in your deployment environment. Never commit real secrets.
PORT=3000
NODE_ENV=production
# Generate with: openssl rand -base64 48
JWT_SECRET=replace_with_a_random_secret_at_least_32_characters
# PostgreSQL connection string from your database host
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_SSL=true
# Set to the exact public website origin, e.g. https://your-domain.example
FRONTEND_ORIGIN=
TRUST_PROXY=false

# SMTP credentials for email verification
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Keep blank until an authorized provider is chosen and integrated
PAYMENT_PROVIDER=
PAYMENT_SECRET_KEY=
VIRTUAL_NUMBER_PROVIDER=
VIRTUAL_NUMBER_API_KEY=
